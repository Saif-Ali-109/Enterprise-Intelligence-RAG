# Enterprise Knowledge Intelligence RAG — environment template.
#
# Copy to `.env` and fill in the two keys. `.env` is git-ignored and MUST NOT be
# committed; `scripts/check_repo_hygiene.sh` fails the build if it ever is.
#
#   cp .env.example .env
#
# Every setting below is environment-driven (Constitution Principle VII). Nothing
# here is hard-coded in source. Defaults are shown as the effective value so you
# can see what happens when a line is absent.
#
# There are exactly TWO required variables. Everything else has a working default
# that was chosen deliberately — changing one changes measured behaviour, so read
# the note before you change it.

# ============================================================================
# REQUIRED — secrets
# ============================================================================
# Never reaches the browser, a log line, an error payload, or version control.
# /config reports these as `{"configured": true}` with no value field at all
# (FR-042). The endpoint that would leak them is written to return nothing.

GROQ_API_KEY=
PINECONE_API_KEY=

# ============================================================================
# Vector store
# ============================================================================
PINECONE_INDEX_NAME=enterprise-knowledge
PINECONE_NAMESPACE=atlassian-public
# The namespace is a reserved key. It is passed as a reserved argument and is
# never written into a record's metadata, because it is not a filter field (R-003).
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# DO NOT change this without reading research.md R-001.
#   llama-text-embed-v2  : 2048-token limit, 1024 default dimension
#   multilingual-e5-large: 512-token limit, and chunks here are 600-1000 tokens
# A 512-token embedder would silently truncate (truncate: "END") the tail of
# nearly every chunk. The model would then be cited for text it never encoded.
# That is a grounding defect, not a ranking-quality preference.
PINECONE_EMBED_MODEL=llama-text-embed-v2

# Swappable without touching any other module — the Reranker interface is fixed.
# Entitlement is account-dependent; T027's smoke test is the authority, not this
# file and not the vendor's documentation.
PINECONE_RERANK_MODEL=bge-reranker-v2-m3

# ============================================================================
# Language model
# ============================================================================
# DO NOT set GROQ_MODEL=llama-3.3-70b-versatile. It is still shown in Groq's own
# quickstart, it went Enterprise-only on 2026-08-16, and it returns 401 on Free
# and Developer plans (R-006).
GROQ_MODEL=openai/gpt-oss-120b
# Classification runs at ~1000 t/s, which is what keeps the 8s budget reachable.
GROQ_CLASSIFICATION_MODEL=openai/gpt-oss-20b
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_TIMEOUT_SECONDS=30.0
# Bounded retry owned by the application, not compounded by the SDK (R-008).
#   429 -> honour retry-after, else jittered backoff
#   498 -> never retried; capacity signal, not a throttle
#   5xx -> retried
#   400 -> never retried; a config bug will not fix itself
GROQ_MAX_RETRIES=1

# ============================================================================
# Database
# ============================================================================
# Defaults to the compose service. Only set this to point at an external database.
# The host port is 5433 rather than the conventional 5432 so that a machine which
# already runs PostgreSQL locally needs no override: a port collision is the most
# common reason `make up` fails, and the common case should be the one that works.
# The database is bound to loopback, so the non-standard host port costs nothing.
# If you want 5432, change POSTGRES_PORT and this line together.
DATABASE_URL=postgresql+asyncpg://knowledge:knowledge@localhost:5433/knowledge
POSTGRES_PORT=5433
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5

# ============================================================================
# Crawler — bounded and allowlisted (FR-027, FR-028, FR-044)
# ============================================================================
# The crawl may not leave this set. A URL outside it is refused with SSRF_BLOCKED
# before any connection is opened, not fetched and then rejected.
ALLOWED_DOMAINS=support.atlassian.com,developer.atlassian.com,confluence.atlassian.com
CRAWL_MAX_PAGES=100
CRAWL_MAX_DEPTH=2
CRAWL_DELAY_SECONDS=1.0
CRAWL_MAX_BYTES=5242880
CRAWL_TIMEOUT_SECONDS=20.0
CRAWL_USER_AGENT=EnterpriseKnowledgeRAG/1.0 (+https://github.com/Saif-Ali-109/Enterprise-Intelligence-RAG; independent demonstration; not affiliated with any documentation publisher)

# ============================================================================
# Ingestion — chunk sizing
# ============================================================================
# Targets, not hard limits. Structure decides the boundaries; these numbers only
# decide when a structural section has grown too large to stay one unit.
CHUNK_TARGET_MIN_TOKENS=600
CHUNK_TARGET_MAX_TOKENS=1000
CHUNK_OVERLAP_TOKENS=100
# A chunk below this floor is rejected and RECORDED, never silently dropped.
CHUNK_MIN_USEFUL_TOKENS=50

# THE size bound that can actually reject a write. Measured from a live
# rejection: "Metadata size is 76009 bytes, which exceeds the limit of 40960
# bytes per vector". A record over this is REFUSED by the service, so the chunker
# must stay under it. It is bytes, not tokens, and the text counts against it
# alongside all the metadata (R-003 amendment, R-013 amendment).
EMBED_BYTES_PER_VECTOR=40960
# What fraction of that one record's TEXT may use. The rest carries heading_path,
# source_url, document_id and the other registry fields, plus JSON overhead.
EMBED_TEXT_BYTE_FRACTION=0.5

# Defence in depth, and NOT the binding bound. T027 showed the hosted embed
# service does not truncate at the 2048-token model limit at all; the byte limit
# above binds first. Kept because a hosted service can change behaviour without
# notice, and one extra comparison is cheap. The effective ceiling is
# EMBED_HARD_TOKEN_LIMIT * EMBED_SAFETY_FACTOR (R-013).
EMBED_HARD_TOKEN_LIMIT=2048
EMBED_SAFETY_FACTOR=0.75

# ============================================================================
# Retrieval budget — 12 -> 6 -> 3-6 (FR-019, FR-020)
#
# The budget narrows at every stage. Rerank top-N is 6 rather than 5 because
# evidence is selected from the reranked set: a 5-wide rerank cannot yield the
# 6 evidence units FR-020 asks for. Raising the evidence maximum above the
# rerank width is refused at startup, not silently capped at runtime.
# ============================================================================
# Configuration, not convention. V12 in the quickstart exists to prove these
# values actually move the measured metrics.
RETRIEVAL_CANDIDATE_POOL=12
RETRIEVAL_RERANK_TOP_N=6
EVIDENCE_MIN_UNITS=3
EVIDENCE_MAX_UNITS=6

# Below either of these the system refuses rather than answering.
# The default is deliberately unset: these are meant to be tuned against a
# MEASURED score distribution, not set to invented values. An invented threshold
# makes the refusal path fire at an arbitrary point and the gates meaningless.
# Set them after T177 records a real run.
# MIN_RERANK_SCORE=
# MIN_EVIDENCE_SCORE=

# Domain filtering is suppressed below this confidence rather than narrowed
# (FR-010, FR-014). A broader search is the correct response to low confidence.
CLASSIFICATION_CONFIDENCE_THRESHOLD=0.6
FILTERS_ENABLED=true

# ============================================================================
# Generation
# ============================================================================
# Hard cap. Regeneration is capped, never an unbounded loop (FR-011).
GENERATION_MAX_ATTEMPTS=2
# Pause between those two attempts. An immediate retry against a rate-limited
# provider is the same request twice.
GENERATION_RETRY_DELAY_SECONDS=1.5
QUESTION_MAX_LENGTH=2000
# Cost control only. The service accepts low|medium|high and rejects anything
# else with HTTP 400; "none" is not available, and both configured models return
# a populated message.reasoning at every accepted effort. FR-034 is therefore
# discharged by discarding the channel at the adapter boundary, not by this
# setting (R-014, FR-034, SC-017).
REASONING_EFFORT=low

# ============================================================================
# API
# ============================================================================
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_GENERAL_PER_MINUTE=60
RATE_LIMIT_ASK_PER_MINUTE=20
LOG_LEVEL=INFO
# Bounded retention for stored questions (FR-048). The column is indexed so a
# purge by created_at is cheap.
QUERY_LOG_RETENTION_DAYS=30

# ============================================================================
# Evaluation gates (FR-065)
# ============================================================================
# These thresholds are CONFIGURATION. What is configurable is the gate's
# value, recorded per run in evaluation_runs.thresholds. What is NOT configurable
# is the value itself: it may never be derived from the run it is judging, or
# the gate stops being a gate (FR-065).
EVAL_GATE_RECALL_AT_5=0.80
EVAL_GATE_PRECISION_AT_5=0.60
EVAL_GATE_MRR=0.75
EVAL_GATE_CROSS_PRODUCT_COVERAGE=0.80
EVAL_GATE_CITATION_VALIDITY=0.98
EVAL_GATE_CLAIM_COVERAGE=0.85
EVAL_GATE_FAITHFULNESS=0.90
EVAL_GATE_UNSUPPORTED_REFUSAL_RATE=1.00
EVAL_GATE_P95_LATENCY_MS=8000

# There is deliberately NO variable for zero fabricated facts or zero invalid
# citation identifiers. Those two are absolute zeros and are checked as counts,
# not ratios, so that no configuration can move them (FR-066). If you add an
# EVAL_GATE_FABRICATION line here, it is a defect — delete it.
