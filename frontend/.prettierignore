# Prettier ignores.
#
# `frontend/` does not commit generated output or a formatter cache, and does
# not run Prettier over dependency trees. Lockfiles are excluded so a resolver
# rewrite is never reflowed into a multi-line diff that hides the actual change.

node_modules/
.next/
out/
build/
dist/
coverage/
playwright-report/
test-results/

package-lock.json
pnpm-lock.yaml
yarn.lock

# Generated by Next.js; formatting it is noise.
next-env.d.ts
*.tsbuildinfo

# Secrets.
.env
.env.*
!.env.example
